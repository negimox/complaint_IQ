# ─── Groq LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_EXTRACT=gemma2-9b-it
GROQ_MODEL_RISK=llama-3.3-70b-versatile

# ─── Supabase / PostgreSQL ────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Copy this block to frontend/.env
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=ComplaintIQ
